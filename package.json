{
  "name": "matchdule",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run test:ci && next build",
    "start": "next start",
    "lint": "eslint",
    "test:storybook": "vitest --project=storybook",
